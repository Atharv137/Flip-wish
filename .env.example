# Firebase Configuration (Modular Web SDK)
# Used for Client-side Firebase Authentication & Firebase Realtime Database (Spark Free Plan)
# Supports both Vite (VITE_*) and Next.js / Netlify (NEXT_PUBLIC_*) prefixes
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=electromart-be5a0.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://electromart-be5a0-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=electromart-be5a0
VITE_FIREBASE_STORAGE_BUCKET=electromart-be5a0.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=699177750485
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=electromart-be5a0.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://electromart-be5a0-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=electromart-be5a0
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=electromart-be5a0.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=699177750485
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional Backend / Server Settings
APP_URL=http://localhost:3000
PORT=3000
